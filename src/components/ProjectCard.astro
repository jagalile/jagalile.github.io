---
import type { Project } from '../lib/github';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const tags = project.topics;
const languageColors: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Python: '#3572a5',
  HTML: '#e34c26',
  CSS: '#663399',
  Astro: '#ff5a03',
  Go: '#00add8',
  Rust: '#dea584',
  Java: '#b07219',
  Kotlin: '#a97bff',
  Shell: '#89e051',
};
const updated = new Date(project.updatedAt);
const searchText = [project.name, project.summary, project.language, ...tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="project group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-sky-700"
  data-search={searchText}
  data-tags={tags.join(',')}
  data-language={project.language ?? ''}
  data-name={project.name.toLowerCase()}
  data-updated={updated.getTime()}
  data-stars={project.stars}
>
  <header class="flex items-start justify-between gap-3">
    <h2 class="text-lg font-semibold break-words text-slate-900 dark:text-slate-100">
      <a href={project.url} class="after:absolute after:inset-0 focus:outline-none" target="_blank" rel="noopener">
        {project.name}
      </a>
    </h2>
    {
      project.stars > 0 && (
        <span class="shrink-0 text-sm text-slate-500 dark:text-slate-400" title="Estrellas">
          ★ {project.stars}
        </span>
      )
    }
  </header>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{project.summary}</p>

  {
    tags.length > 0 && (
      <ul class="relative z-10 mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li>
            <button
              type="button"
              data-tag-chip={tag}
              class="rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-medium text-sky-700 hover:bg-sky-100 dark:bg-sky-950 dark:text-sky-300 dark:hover:bg-sky-900"
            >
              #{tag}
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <footer class="mt-4 flex items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
    <span class="flex items-center gap-3">
      {
        project.language && (
          <span class="flex items-center gap-1.5">
            <span
              class="h-2.5 w-2.5 rounded-full"
              style={`background-color: ${languageColors[project.language] ?? '#94a3b8'}`}
            />
            {project.language}
          </span>
        )
      }
      <time datetime={project.updatedAt}>
        {updated.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
      </time>
    </span>
    {
      project.homepage && (
        <a
          href={project.homepage}
          target="_blank"
          rel="noopener"
          class="relative z-10 rounded-md px-2 py-1 font-medium text-sky-700 hover:bg-sky-50 dark:text-sky-300 dark:hover:bg-sky-950"
        >
          Demo ↗
        </a>
      )
    }
  </footer>
</article>
